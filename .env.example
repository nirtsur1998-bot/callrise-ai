# ── Sales OS environment variables ──────────────────────────────────
# Deepgram API key for live microphone transcription.
#
# Get one free (no credit card) at: https://console.deepgram.com/signup
# Then copy this file to ".env" and paste your key after the "=".
#
#   DEEPGRAM_API_KEY=your_key_here
#
# The ".env" file is gitignored, so your key is never committed.
DEEPGRAM_API_KEY=

# Anthropic API key for AI call summaries.
# Get one at: https://console.anthropic.com/  (Settings → API Keys)
# Paste it after the "=" (no quotes).
ANTHROPIC_API_KEY=

# Supabase — user accounts (sign-up / log-in).
# Create a free project at https://supabase.com, then copy these from
# Project Settings → API Keys:
#   SUPABASE_URL       = your Project URL (e.g. https://abcd1234.supabase.co)
#   SUPABASE_ANON_KEY  = the public "anon"/"Publishable" key
#                        (NOT the secret / service_role key)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Calendar — connect + two-way sync.
# Create a project at https://console.cloud.google.com, enable the "Google
# Calendar API", then create an OAuth client (Application type: Desktop app)
# under APIs & Services → Credentials:
#   GOOGLE_CLIENT_ID     = the client ID
#   GOOGLE_CLIENT_SECRET = the client secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft 365 Calendar — connect + two-way sync.
# Register a free app at https://portal.azure.com → "App registrations" → New
# registration:
#   - Supported account types: "Accounts in any organizational directory and
#     personal Microsoft accounts" (so both work/school and outlook.com/
#     hotmail.com accounts can connect)
#   - Platform: under Authentication → Add a platform → "Mobile and desktop
#     applications" → add redirect URI http://localhost (the app picks an open
#     port automatically; this exact URI just needs to be registered once)
#   - No client secret needed — this is a "public client" (desktop) app
#   OUTLOOK_CLIENT_ID = the "Application (client) ID" shown on the app's Overview page
#   OUTLOOK_TENANT_ID = optional; leave blank unless your organization
#                       requires a specific tenant (defaults to "common",
#                       which allows both personal and work/school accounts)
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=
