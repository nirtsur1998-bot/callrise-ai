{
  "name": "callrise-ai",
  "version": "1.2.3",
  "description": "CallRise AI — desktop AI assistant for sales calls",
  "main": "./out/main/index.js",
  "author": "",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:build:mac": "node scripts/build-native.js native/mac-audio-activity",
    "native:build:win": "node scripts/build-native.js native/win-audio-sessions",
    "detect:debug": "node scripts/debug-detect.js",
    "simulate:call": "tsx scripts/run-call-simulator.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run native:build:win && npm run build && electron-builder --win",
    "build:mac": "npm run native:build:mac && electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "diagnose": "electron-vite build && electron out/main/index.js --diagnose"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@azure/msal-node": "^5.3.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@supabase/supabase-js": "^2.110.0",
    "@xenova/transformers": "^2.17.2",
    "active-win": "^8.2.1",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "google-auth-library": "^10.9.0",
    "lucide-react": "^1.22.0",
    "mammoth": "^1.12.0",
    "openai": "^7.0.0",
    "sqlite-vec": "^0.1.9",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "happy-dom": "^20.11.2",
    "node-addon-api": "^8.9.0",
    "node-gyp": "^13.0.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
