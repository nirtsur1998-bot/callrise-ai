From b752a3251cec1bd02c117111fe0e91ef2462b542 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 29 Jul 2026 06:25:07 +0000
Subject: [PATCH 38/39] fix: apply-fuses.js used the wrong binary name on Linux
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Found while sanity-checking the packaging pipeline before handoff: `npm run
build:linux` failed at the fuse-flipping afterPack step with ENOENT, because
the Linux branch guessed the binary was named exactly after productName
("CallRise AI"), the same assumption that happens to be correct for macOS
(the .app bundle name) and for Windows only because electron-builder.yml
explicitly sets win.executableName to match. Linux has no such override, and
electron-builder's real default there is a filesystem-sanitized, lowercased
name ("callrise-ai") — so every Linux package silently never had its fuses
applied at all, and would have shipped without them if this was ever run
prior to now.

Fixed by reading packager.executableName for the Linux case — the same
accessor electron-builder's own afterPack ecosystem (e.g. its notarize step)
uses for exactly this. Verified end-to-end: `npm run build:linux` now
produces a working AppImage and snap with fuses correctly locked
(confirmed via `flipFuses` succeeding and the packaged binary launching and
running stably), where it previously failed outright.
---
 scripts/apply-fuses.js | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/scripts/apply-fuses.js b/scripts/apply-fuses.js
index a7cd4ed..6116e67 100644
--- a/scripts/apply-fuses.js
+++ b/scripts/apply-fuses.js
@@ -47,12 +47,19 @@ exports.default = async function applyFuses(context) {
   const { electronPlatformName, appOutDir, packager } = context
   const productName = packager.appInfo.productFilename
 
+  // macOS and Windows both end up naming the binary after productName here —
+  // Windows only because electron-builder.yml sets win.executableName to
+  // match it exactly. Linux has no such override, and electron-builder's own
+  // default there is a filesystem-sanitized, lowercased name ("CallRise AI"
+  // becomes "callrise-ai"), not productName verbatim — so it needs
+  // packager.executableName, the same accessor electron-builder's own
+  // afterPack ecosystem (e.g. its notarize step) uses for exactly this.
   const binary =
     electronPlatformName === 'darwin'
       ? `${appOutDir}/${productName}.app`
       : electronPlatformName === 'win32'
         ? `${appOutDir}/${productName}.exe`
-        : `${appOutDir}/${productName}`
+        : `${appOutDir}/${packager.executableName}`
 
   await flipFuses(binary, {
     version: FuseVersion.V1,
-- 
